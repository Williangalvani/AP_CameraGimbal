+// Sends pending_ without blocking. Returns false if the socket is full and
+// pending_ must be retried; true once it is sent or dropped.
+bool RtpConnection::SendPending(std::shared_ptr<TcpConnection>& conn)
+{
+    const MediaChannelId channel_id = pending_.channel_id;
+    RtpPacket& pkt = pending_.pkt;
+    auto &info = media_channel_info_[channel_id];
+    if (!pending_ready_) {
+        if (transport_mode_ == RTP_OVER_TCP && conn->QueuedPackets() >= kMaxTcpQueuedPackets) {
+            return false;
+        }
+        this->SetFrameType(pkt.type);
+        this->SetRtpHeader(channel_id, pkt);
+        if (!(info.is_play || info.is_record) || !has_key_frame_) {
+            return true;
+        }
+        pending_ready_ = true;
+    }
+
+    const int sent = transport_mode_ == RTP_OVER_TCP
+        ? SendRtpOverTcp(channel_id, pkt) : SendRtpOverUdp(channel_id, pkt);
+    if (sent == 0) {
+        // Every client writes its own header into the one shared buffer.
+        if (!pending_private_) {
+            RtpPacket copy;
+            memcpy(copy.data.get(), pkt.data.get(), pkt.size);
+            copy.size = pkt.size;
+            copy.timestamp = pkt.timestamp;
+            copy.type = pkt.type;
+            copy.last = pkt.last;
+            pkt = copy;
+            pending_private_ = true;
+        }
+        return false;
+    }
+    if (sent < 0) {
+        return true;
+    }
+
+    info.packet_count++;
+    info.octet_count += pkt.size - RTP_TCP_HEAD_SIZE - RTP_HEADER_SIZE;
+    const uint64_t ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    const uint64_t ntp = ((ns / 1000000000ULL + 2208988800ULL) << 32) |
+        (((ns % 1000000000ULL) << 32) / 1000000000ULL);
+    if (info.last_rtcp_ntp_time == 0 ||
+        ntp - info.last_rtcp_ntp_time >= (uint64_t(5) << 32)) {
+        uint8_t report[68];
+        const size_t length = ca_rtsp_sender_report(report + 4,
+            ntohl(info.rtp_header.ssrc), ntp, ntohl(info.rtp_header.ts),
+            uint32_t(info.packet_count), uint32_t(info.octet_count));
+        if (transport_mode_ == RTP_OVER_TCP) {
+            report[0] = '$'; report[1] = info.rtcp_channel;
+            report[2] = length >> 8; report[3] = length;
+            conn->Send(reinterpret_cast<const char *>(report), length + 4);
+        } else {
+            (void)sendto(rtcpfd_[channel_id], report + 4, length, kSendFlags,
+                reinterpret_cast<struct sockaddr *>(&peer_rtcp_sddr_[channel_id]),
+                sizeof(struct sockaddr_in));
+        }
+        info.last_rtcp_ntp_time = ntp;
+    }
+    return true;
 }
 
