+// On the event loop, never lose a scheduled drain: a refused trigger falls
+// back to a timer that retries the post. Timer callbacks must not touch the
+// timer queue, so the timer only posts and the drain runs as a trigger event.
+void RtpConnection::ScheduleDrain(std::shared_ptr<TcpConnection> conn, uint32_t delay_ms)
+{
+    TaskScheduler *scheduler = ((RtspConnection *)conn.get())->task_scheduler_;
+    TriggerEvent drain = [this, conn] { DrainQueue(conn); };
+    if (delay_ms == 0 && scheduler->AddTriggerEvent(drain)) {
+        return;
+    }
+    scheduler->AddTimer([scheduler, drain] { return !scheduler->AddTriggerEvent(drain); },
+                        delay_ms ? delay_ms : 1);
+}
+
+void RtpConnection::DrainQueue(std::shared_ptr<TcpConnection> conn)
+{
+    for (int budget = kDrainBudget; budget > 0; budget--) {
+        if (!has_pending_) {
+            std::lock_guard<std::mutex> lock(queue_mutex_);
