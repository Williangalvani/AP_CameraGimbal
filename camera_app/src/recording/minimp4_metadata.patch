+/* The HEVCDecoderConfigurationRecord fields a player reads before it decodes
+ * any parameter set: general profile_tier_level, chroma format, bit depths
+ * and temporal layers, all from the first SPS. */
+typedef struct
+{
+    unsigned char ptl[12];
+    int chroma_format_idc, bit_depth_luma_minus8, bit_depth_chroma_minus8;
+    int max_sub_layers, temporal_id_nested;
+} hevc_sps_config_t;
+
+static int hevc_read_bits(const unsigned char *rbsp, int bits, int *pos, int count)
+{
+    int value = 0;
+    if (count > 24 || *pos + count > bits)
+        return -1;
+    while (count--)
+    {
+        value = (value << 1) | ((rbsp[*pos >> 3] >> (7 - (*pos & 7))) & 1);
+        (*pos)++;
+    }
+    return value;
+}
+
+static int hevc_read_ue(const unsigned char *rbsp, int bits, int *pos)
+{
+    int zeros = 0, suffix;
+    for (;;)
+    {
+        int bit = hevc_read_bits(rbsp, bits, pos, 1);
+        if (bit < 0 || zeros > 16)
+            return -1;
+        if (bit)
+            break;
+        zeros++;
+    }
+    suffix = hevc_read_bits(rbsp, bits, pos, zeros);
+    return suffix < 0 ? -1 : (1 << zeros) - 1 + suffix;
+}
+
+/* The RBSP of a NAL unit after its header_bytes-byte header, without
+ * emulation prevention; returns its length, at most capacity. */
+static int nal_rbsp(const unsigned char *nal, int bytes, int header_bytes, unsigned char *rbsp, int capacity)
+{
+    int n = 0, zeros = 0, i;
+    for (i = header_bytes; i < bytes && n < capacity; i++)
+    {
+        if (zeros >= 2 && nal[i] == 3)
+        {
+            zeros = 0;
+            continue;
+        }
+        zeros = nal[i] ? 0 : zeros + 1;
+        rbsp[n++] = nal[i];
+    }
+    return n;
+}
+
+/* Reads an H.265 SPS RBSP of bits through sps_seq_parameter_set_id, past
+ * the profile_tier_level, leaving pos after it. Returns the ID, or -1. */
+static int hevc_sps_id(const unsigned char *rbsp, int bits, int *pos)
+{
+    unsigned char present[8];
+    int i, sub_layers_minus1;
+    if (bits < 13*8)
+        return -1;
+    sub_layers_minus1 = (rbsp[0] >> 1) & 7;
+    *pos = 8 + 96;
+    for (i = 0; i < sub_layers_minus1; i++)
+    {
+        int flags = hevc_read_bits(rbsp, bits, pos, 2);
+        if (flags < 0)
+            return -1;
+        present[i] = (unsigned char)flags;
+    }
+    if (sub_layers_minus1 > 0)
+        *pos += 2*(8 - sub_layers_minus1);
+    for (i = 0; i < sub_layers_minus1; i++)
+        *pos += ((present[i] & 2) ? 88 : 0) + ((present[i] & 1) ? 8 : 0);
+    return hevc_read_ue(rbsp, bits, pos);
+}
+
+/* Returns 0, leaving the defaults, for an SPS it cannot read. */
+static int hevc_sps_config(const unsigned char *nal, int bytes, hevc_sps_config_t *c)
+{
+    unsigned char rbsp[256];
+    int n = nal_rbsp(nal, bytes, 2, rbsp, (int)sizeof(rbsp));
+    int i, pos, bits = n*8, sub_layers_minus1, chroma, luma_depth, chroma_depth;
+    if (hevc_sps_id(rbsp, bits, &pos) < 0)
+        return 0;
+    sub_layers_minus1 = (rbsp[0] >> 1) & 7;
+    chroma = hevc_read_ue(rbsp, bits, &pos);
+    if (chroma < 0 || chroma > 3 || (chroma == 3 && hevc_read_bits(rbsp, bits, &pos, 1) < 0))
+        return 0;
+    if (hevc_read_ue(rbsp, bits, &pos) < 0 || hevc_read_ue(rbsp, bits, &pos) < 0)
+        return 0;
+    i = hevc_read_bits(rbsp, bits, &pos, 1);   // conformance_window_flag
+    if (i < 0)
+        return 0;
+    if (i)
+    {
+        for (i = 0; i < 4; i++)
+            if (hevc_read_ue(rbsp, bits, &pos) < 0)
+                return 0;
+    }
+    luma_depth = hevc_read_ue(rbsp, bits, &pos);
+    chroma_depth = hevc_read_ue(rbsp, bits, &pos);
+    if (luma_depth < 0 || luma_depth > 7 || chroma_depth < 0 || chroma_depth > 7)
+        return 0;
+    memcpy(c->ptl, rbsp + 1, sizeof(c->ptl));
+    c->chroma_format_idc = chroma;
+    c->bit_depth_luma_minus8 = luma_depth;
+    c->bit_depth_chroma_minus8 = chroma_depth;
+    c->max_sub_layers = sub_layers_minus1 + 1;
+    c->temporal_id_nested = rbsp[0] & 1;
+    return 1;
+}
