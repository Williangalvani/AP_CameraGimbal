+// Runs on the event loop in a timer callback, so it must not add or remove
+// timers; Disconnect() only queues the close.
+void RtspServer::CloseIdleConnections()
+{
+    const int64_t now = RtspConnection::NowMs();
+    std::lock_guard<std::mutex> locker(TcpServer::mutex_);
+    for (auto& entry : connections_) {
+        auto conn = std::static_pointer_cast<RtspConnection>(entry.second);
+        if (conn->IsClosed() || now - conn->LastAliveMs() <= kSessionTimeoutMs) {
+            continue;
+        }
+        ca_rtsp_log("RTSP client %s:%u sent nothing for %lld s; closing", conn->GetIp().c_str(),
+                    conn->GetPort(), (long long)((now - conn->LastAliveMs()) / 1000));
+        conn->Disconnect();
+    }
+}
+
+// At kMaxConnections, make room by closing the least recently active
+// connection that is not playing; with every slot playing, refuse.
+bool RtspServer::AdmitConnection(SOCKET sockfd)
+{
+    std::shared_ptr<RtspConnection> victim;
+    {
+        std::lock_guard<std::mutex> locker(TcpServer::mutex_);
+        size_t open = 0;
+        for (auto& entry : connections_) {
+            auto conn = std::static_pointer_cast<RtspConnection>(entry.second);
+            if (conn->IsClosed() || conn->evicted_) {
+                continue;
+            }
+            open++;
+            if (!conn->IsPlay() && !conn->IsRecord() &&
+                (!victim || conn->LastAliveMs() < victim->LastAliveMs())) {
+                victim = conn;
+            }
+        }
+        if (open < kMaxConnections) {
+            return true;
+        }
+        if (victim) {
+            victim->evicted_ = true;
+            victim->Disconnect();
+        }
+    }
+    if (victim) {
+        ca_rtsp_log("RTSP: %zu connections; closing idle %s:%u for a new one", (size_t)kMaxConnections,
+                    victim->GetIp().c_str(), victim->GetPort());
+        return true;
+    }
+    ca_rtsp_log("RTSP: %zu clients playing; refusing %s:%u", (size_t)kMaxConnections,
+                SocketUtil::GetPeerIp(sockfd).c_str(), SocketUtil::GetPeerPort(sockfd));
+    static const char busy[] = "RTSP/1.0 503 Service Unavailable\r\nContent-Length: 0\r\n\r\n";
+    int flags = 0;
+#ifdef MSG_DONTWAIT
+    flags |= MSG_DONTWAIT;
+#endif
+#ifdef MSG_NOSIGNAL
+    flags |= MSG_NOSIGNAL;
+#endif
+    (void)::send(sockfd, busy, sizeof(busy) - 1, flags);
+    SocketUtil::Close(sockfd);
+    return false;
+}
