+use std::sync::Arc;
+
+use anyhow::{Result, anyhow};
+use gst::prelude::*;
+use tracing::*;
+
+use crate::{
+    stream::types::CaptureConfiguration,
+    video::{
+        types::{VideoEncodeType, VideoSourceType},
+        video_source_gst::{VideoSourceGstType, apcam},
+    },
+    video_stream::types::VideoAndStreamInformation,
+};
+
+use super::{
+    PIPELINE_FILTER_NAME, PIPELINE_RTP_TEE_NAME, PIPELINE_VIDEO_TEE_NAME,
+    PipelineGstreamerInterface, PipelineState,
+};
+
+/// camera-app's encoded video straight from its frame socket: no RTSP, no
+/// RTP depayloading, one payloader.
+#[derive(Debug)]
+pub struct ApcamPipeline {
+    pub state: PipelineState,
+}
+
+impl ApcamPipeline {
+    #[instrument(level = "debug", skip_all)]
+    pub fn try_new(
+        pipeline_id: &Arc<uuid::Uuid>,
+        video_and_stream_information: &VideoAndStreamInformation,
+    ) -> Result<gst::Pipeline> {
+        let configuration = match &video_and_stream_information
+            .stream_information
+            .configuration
+        {
+            CaptureConfiguration::Video(configuration) => configuration,
+            unsupported => {
+                return Err(anyhow!("{unsupported:?} is not supported as ApCam Pipeline"));
+            }
+        };
+
+        let stream = match &video_and_stream_information.video_source {
+            VideoSourceType::Gst(source) => match &source.source {
+                VideoSourceGstType::ApCam(source) => apcam::stream(source),
+                _ => None,
+            },
+            _ => None,
+        }
+        .ok_or_else(|| {
+            anyhow!(
+                "VideoSourceType {:?} is not supported as ApCam Pipeline",
+                video_and_stream_information.video_source
+            )
+        })?;
+
+        let filter_name = format!("{PIPELINE_FILTER_NAME}-{pipeline_id}");
+        let video_tee_name = format!("{PIPELINE_VIDEO_TEE_NAME}-{pipeline_id}");
+        let rtp_tee_name = format!("{PIPELINE_RTP_TEE_NAME}-{pipeline_id}");
+
+        let (codec, stream_format) = match &configuration.encode {
+            VideoEncodeType::H264 => ("h264", "avc"),
+            VideoEncodeType::H265 => ("h265", "byte-stream"),
+            unsupported => {
+                return Err(anyhow!(
+                    "Encode {unsupported:?} is not supported for ApCam Pipeline"
+                ));
+            }
+        };
+
+        let description = format!(
+            concat!(
+                "apcamsrc stream={stream}",
+                " ! {codec}parse config-interval=-1",
+                " ! capsfilter name={filter_name} caps=video/x-{codec},stream-format={stream_format},alignment=au",
+                " ! tee name={video_tee_name} allow-not-linked=true",
+                " ! rtp{codec}pay aggregate-mode=zero-latency config-interval=-1 pt=96",
+                " ! tee name={rtp_tee_name} allow-not-linked=true",
+            ),
+            stream = stream,
+            codec = codec,
+            stream_format = stream_format,
+            filter_name = filter_name,
+            video_tee_name = video_tee_name,
+            rtp_tee_name = rtp_tee_name,
+        );
+
+        debug!("pipeline_description: {description:#?}");
+        let pipeline = gst::parse::launch(&description)?;
+
+        let pipeline = pipeline
+            .downcast::<gst::Pipeline>()
+            .expect("Couldn't downcast pipeline");
+
+        pipeline.set_property("name", format!("pipeline-apcam-{pipeline_id}"));
+
+        Ok(pipeline)
+    }
+}
+
+impl PipelineGstreamerInterface for ApcamPipeline {
+    #[instrument(level = "trace")]
+    fn is_running(&self) -> bool {
+        self.state.pipeline_runner.is_running()
+    }
+}
