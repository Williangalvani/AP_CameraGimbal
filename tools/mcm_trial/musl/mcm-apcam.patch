+/// nicesink sends each frame's RTP packets back to back. A 4K keyframe is
+/// ~450 packets and the default 208 KB socket send buffer holds ~90, so the
+/// kernel drops the rest and every keyframe waits for retransmissions.
+/// `SO_SNDBUFFORCE` (root or `CAP_NET_ADMIN`) is not capped by `wmem_max`.
+const ICE_SEND_BUFFER_BYTES: i32 = 4 << 20;
+
+fn enlarge_ice_send_buffer(agent: &glib::Object, stream: u32, component: u32) {
+    use gio::prelude::*;
+
+    type GetSelectedSocket = unsafe extern "C" fn(
+        *mut glib::gobject_ffi::GObject,
+        u32,
+        u32,
+    ) -> *mut gio::ffi::GSocket;
+
+    // GStreamer loads libnice privately with its plugin, so look it up by name
+    static GET_SELECTED_SOCKET: std::sync::OnceLock<Option<GetSelectedSocket>> =
+        std::sync::OnceLock::new();
+    let get_selected_socket = GET_SELECTED_SOCKET.get_or_init(|| unsafe {
+        let library = libc::dlopen(c"libnice.so.10".as_ptr(), libc::RTLD_NOW | libc::RTLD_NOLOAD);
+        if library.is_null() {
+            return None;
+        }
+        let symbol = libc::dlsym(library, c"nice_agent_get_selected_socket".as_ptr());
+        (!symbol.is_null()).then(|| std::mem::transmute::<*mut libc::c_void, GetSelectedSocket>(symbol))
+    });
+    let Some(get_selected_socket) = get_selected_socket else {
+        warn!("libnice has no nice_agent_get_selected_socket; ICE send buffer left at default");
+        return;
+    };
+
+    let socket = unsafe { get_selected_socket(agent.as_ptr() as *mut _, stream, component) };
+    if socket.is_null() {
+        debug!("ICE stream {stream} component {component}: no local socket (relayed?)");
+        return;
+    }
+    let socket: gio::Socket = unsafe { glib::translate::from_glib_full(socket) };
+    if socket
+        .set_option(libc::SOL_SOCKET, libc::SO_SNDBUFFORCE, ICE_SEND_BUFFER_BYTES)
+        .is_err()
+    {
+        let _ = socket.set_option(libc::SOL_SOCKET, libc::SO_SNDBUF, ICE_SEND_BUFFER_BYTES);
+    }
+    match socket.option(libc::SOL_SOCKET, libc::SO_SNDBUF) {
+        Ok(size) => info!("ICE stream {stream} component {component}: send buffer {size} bytes"),
+        Err(error) => warn!("ICE send buffer size unknown: {error}"),
+    }
+}
