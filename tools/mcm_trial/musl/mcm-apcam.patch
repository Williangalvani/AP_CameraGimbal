+pub mod apcam {
+    use std::io::{Read, Write};
+
+    use super::*;
+
+    pub const SOCKET: &[u8] = b"apcam/video";
+    pub const SOURCES: [(&str, &str); 2] = [
+        ("apcam:main", "camera-app main stream"),
+        ("apcam:sub", "camera-app sub stream"),
+    ];
+
+    pub fn stream(source: &str) -> Option<u8> {
+        match source {
+            "apcam:main" => Some(0),
+            "apcam:sub" => Some(1),
+            _ => None,
+        }
+    }
+
+    /// Asks camera-app's frame socket what the stream is; see camera-app's
+    /// frame_socket.h for the protocol.
+    pub fn format(source: &str) -> Option<Format> {
+        use std::os::linux::net::SocketAddrExt;
+        use std::os::unix::net::{SocketAddr, UnixStream};
+
+        let stream = stream(source)?;
+        let address = SocketAddr::from_abstract_name(SOCKET).ok()?;
+        let mut socket = UnixStream::connect_addr(&address).ok()?;
+        let timeout = Some(std::time::Duration::from_secs(1));
+        socket.set_read_timeout(timeout).ok()?;
+        socket.set_write_timeout(timeout).ok()?;
+        socket.write_all(&[b'A', b'P', b'V', b'R', 1, stream, 0, 0]).ok()?;
+        let mut info = [0u8; 16];
+        socket.read_exact(&mut info).ok()?;
+        if &info[..4] != b"APVS" || info[4] != 1 || info[5] != 0 {
+            return None;
+        }
+        let encode = match info[6] {
+            1 => VideoEncodeType::H264,
+            2 => VideoEncodeType::H265,
+            _ => return None,
+        };
+        let u16_at = |i: usize| u16::from_le_bytes([info[i], info[i + 1]]) as u32;
+        Some(Format {
+            encode,
+            sizes: vec![Size {
+                width: u16_at(8),
+                height: u16_at(10),
+                intervals: vec![FrameInterval {
+                    numerator: 1,
+                    denominator: u16_at(12),
+                }],
+            }],
+        })
+    }
+}
